# Interpreter and tool leftovers
__pycache__/
*.py[cod]
.pytest_cache/
*.orig
*.tmp
*.rej

# Leftovers of `pip install -e .`
build/
dist/
*.egg-info/

# runs/: only the registry is versioned, run payloads stay on disk.
# Rule order matters: git cannot re-include a file from an excluded
# directory, so `!runs/*/` must come before the per-file negations.
runs/**
!runs/*/
!runs/INDEX.md
!runs/*/manifest.json
!runs/*/metrics.json
!runs/*/cmd.sh
!runs/*/*.md
!runs/*/judge_diagnostics.json
# The top level of runs/ holds the runs behind the main tables; all other runs
# live in runs/runs_history/<run>/. The negations are repeated for the second
# level because one gitignore pattern cannot express both.
!runs/runs_history/*/
!runs/runs_history/*/manifest.json
!runs/runs_history/*/metrics.json
!runs/runs_history/*/cmd.sh
!runs/runs_history/*/*.md
!runs/runs_history/*/judge_diagnostics.json
!runs/shared/hotpotqa_dev_title_coverage.json
!runs/shared/2wiki_dev_title_coverage.json
!runs/shared/musique_ans_dev_title_coverage.json
!runs/shared/hotpotqa_dev_pool_diagnostics.json
!runs/shared/hotpotqa_dev_pool_diagnostics_k500.json
!runs/shared/hotpotqa_dev_pool_diagnostics_k1000.json
!runs/shared/hotpot_train_q0_s1_title_coverage.json
!runs/shared/2wiki_train_q0_s1_title_coverage.json
!runs/shared/combined_train_q0_s1_title_coverage.json

# Ignoring by default is deliberate: it protects the repository from an
# accidentally committed multi-gigabyte JSONL. To version a new small
# artifact, add a negation for it above.

# Archive of retired runs
runs/_archive/

# Raw training mix: the parquet files (426 MB) and the episode-weight file are
# rebuilt by `python src/build_train_mix.py` from the manifest and holdout,
# so only those two are versioned.
train_data/raw/
train_data/weights/
